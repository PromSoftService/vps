  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "endtheh238.promsoftservice.online",
            "port": 443,
            "users": [
              {
                "id": "c8e4a5dc-fbf0-4246-81fb-8582ebf2aa61",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
