############################################
# IMAGE VERSIONS
############################################

XRAY_IMAGE=ghcr.io/xtls/xray-core:26.3.27
NGINX_IMAGE=nginx:1.27-alpine

############################################
# SERVER / INBOUND
############################################

# Public domain pointed to this VPS.
DOMAIN=example.com

# Port exposed on the host. For REALITY + fallback this is usually 443.
XRAY_PORT=443

# UUID for VLESS authentication.
XRAY_UUID=11111111-2222-3333-4444-555555555555

# Xray log level: debug / info / warning / error / none
XRAY_LOGLEVEL=warning

# Vision flow for REALITY.
XRAY_FLOW=xtls-rprx-vision

############################################
# REALITY
############################################

# Target site used by REALITY. Use host:443 form.
# Prefer a stable HTTPS site from the same ASN / network neighborhood if you know what you're doing.
REALITY_TARGET=www.cloudflare.com:443

# ServerNames that clients are allowed to use (comma-separated).
# Usually includes the same hostname as REALITY_TARGET host.
REALITY_SERVER_NAMES=www.cloudflare.com

# Private key for REALITY. Leave AUTO to let init.sh generate one.
REALITY_PRIVATE_KEY=AUTO

# Short ID in hex, even length, up to 16 hex chars. Leave AUTO to generate.
REALITY_SHORT_ID=AUTO

# Optional: show dest in xray remarks / generated docs.
REALITY_SPIDERX=/

# Client hello fingerprint for generated client config.
REALITY_FINGERPRINT=chrome

############################################
# SERVER STREAM SOCKOPT
############################################

# Enable streamSettings.sockopt in generated server config: yes / no
SERVER_SOCKOPT_ENABLED=yes

# Used only when SERVER_SOCKOPT_ENABLED=yes
SERVER_SOCKOPT_TCP_FAST_OPEN=false
SERVER_SOCKOPT_TCP_KEEP_ALIVE_IDLE=300
SERVER_SOCKOPT_TCP_KEEP_ALIVE_INTERVAL=0

############################################
# CLIENT OUTBOUND MUX
############################################

# Enable outbound mux in generated client config: yes / no
REALITY_MUX_ENABLED=no

# Used only when REALITY_MUX_ENABLED=yes
REALITY_MUX_CONCURRENCY=8
REALITY_MUX_XUDP_CONCURRENCY=16
REALITY_MUX_XUDP_PROXY_UDP_443=reject

############################################
# CLIENT STREAM SOCKOPT
############################################

# Enable streamSettings.sockopt in generated client config: yes / no
CLIENT_SOCKOPT_ENABLED=yes

# Used only when CLIENT_SOCKOPT_ENABLED=yes
CLIENT_SOCKOPT_TCP_FAST_OPEN=false
CLIENT_SOCKOPT_TCP_KEEP_ALIVE_IDLE=300
CLIENT_SOCKOPT_TCP_KEEP_ALIVE_INTERVAL=0

############################################
# FALLBACK NGINX
############################################

# Internal HTTP port for fallback website.
NGINX_FALLBACK_PORT=8080

# Nginx server_name for local fallback HTTP service.
NGINX_SERVER_NAME=_

# If yes, also expose 80/tcp on the host for plain HTTP access to the decoy page.
EXPOSE_HTTP_PORT=no