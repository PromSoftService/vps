############################################
# IMAGE VERSIONS
############################################

XRAY_IMAGE=ghcr.io/xtls/xray-core:26.3.27

# Stable default. HTTP/3 can be enabled only if the selected image really supports it.
NGINX_IMAGE=nginx:1.27-alpine

CERTBOT_IMAGE=certbot/certbot:latest

############################################
# DOMAIN / TLS
############################################

DOMAIN=example.com
EMAIL=you@example.com

############################################
# XRAY INBOUND
############################################

XRAY_UUID=11111111-2222-3333-4444-555555555555

# WebSocket path. Keep /ws for HTML fallback on /.
XRAY_PATH=/ws

# Internal Xray port inside Docker network.
XRAY_PORT=10000

# debug / info / warning / error / none
XRAY_LOGLEVEL=warning

# uTLS fingerprint used in generated client config.
XRAY_FINGERPRINT=chrome

############################################
# XRAY DNS / DOH
############################################

DOH_URL=https://1.1.1.1/dns-query

############################################
# CLIENT PROFILE
############################################

# Keep TCP-only by default for stability with browsers through Happ.
CLIENT_SOCKS_UDP=false
CLIENT_SNIFF_QUIC=false
CLIENT_ALPN=http/1.1

# Mux is disabled by default.
CLIENT_MUX_ENABLED=false
CLIENT_MUX_CONCURRENCY=-1
CLIENT_MUX_XUDP_CONCURRENCY=8
CLIENT_MUX_XUDP_PROXY_UDP_443=

############################################
# NGINX / HTML FALLBACK / OPTIONAL H3
############################################

NGINX_HTTP2=on

# Off by default. H3 is for the HTML fallback site only; WS proxy still uses HTTP/1.1.
NGINX_HTTP3=off

# If NGINX_HTTP3=on and the image lacks HTTP/3 support:
# - no: auto-disable H3 with warning and still start stack
# - yes: fail fast
NGINX_HTTP3_STRICT=no
VERIFY_HTTP3_IMAGE=yes

NGINX_ALTSVC_MAX_AGE=86400
NGINX_HSTS_MAX_AGE=31536000
NGINX_PROXY_READ_TIMEOUT=3600s
NGINX_PROXY_SEND_TIMEOUT=3600s
