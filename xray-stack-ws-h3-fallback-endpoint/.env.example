#!/usr/bin/env bash

############################################
# IMAGE VERSIONS
############################################

# Official Xray image tag.
XRAY_IMAGE=ghcr.io/xtls/xray-core:26.3.27

# HTTP/3-capable nginx image.
# Keep it pinned.
NGINX_IMAGE=macbre/nginx-http3:1.29.7

# Official Certbot image.
CERTBOT_IMAGE=certbot/certbot:latest


############################################
# DOMAIN / TLS
############################################

# Public domain pointed to this VPS.
DOMAIN=example.com

# Email for Let's Encrypt notices.
EMAIL=you@example.com


############################################
# XRAY INBOUND: VLESS + WS
############################################

# UUID for VLESS authentication.
XRAY_UUID=11111111-2222-3333-4444-555555555555

# Secret WebSocket path used by Xray transport.
# Keep it separate from / so browser fallback page can work normally.
XRAY_PATH=/ws

# Internal Xray listen port inside Docker network.
XRAY_PORT=10000

# Xray log level: debug / info / warning / error / none
XRAY_LOGLEVEL=warning

# uTLS fingerprint used in generated client config.
XRAY_FINGERPRINT=chrome

# Client TLS ALPN. For WebSocket keep http/1.1 by default.
XRAY_CLIENT_ALPN=http/1.1


############################################
# CLIENT LOCAL PROXY / UDP
############################################

# Enable UDP on generated client SOCKS inbound: yes / no
# Default no is safer for browsers on unstable/DPI-heavy providers.
CLIENT_UDP_ENABLED=no

# Add quic to sniffing.destOverride when CLIENT_UDP_ENABLED=yes: yes / no
CLIENT_SNIFF_QUIC=no


############################################
# CLIENT MUX
############################################

# Enable outbound mux in generated client config: yes / no
XRAY_MUX_ENABLED=no

# Used only when XRAY_MUX_ENABLED=yes
XRAY_MUX_CONCURRENCY=8
XRAY_MUX_XUDP_CONCURRENCY=16
XRAY_MUX_XUDP_PROXY_UDP_443=reject


############################################
# XRAY DNS / DOH
############################################

# DNS-over-HTTPS resolver used by Xray and generated client config.
DOH_URL=https://1.1.1.1/dns-query


############################################
# NGINX / H3 / FALLBACK
############################################

# Keep H2 enabled for browser fallback.
NGINX_HTTP2=on

# Enable H3/QUIC for the browser fallback site.
# WebSocket client profile still uses HTTP/1.1 ALPN.
NGINX_HTTP3=on

# Alt-Svc max-age in seconds.
NGINX_ALTSVC_MAX_AGE=86400

# HSTS max-age in seconds.
NGINX_HSTS_MAX_AGE=31536000

# Upstream timeouts.
NGINX_PROXY_READ_TIMEOUT=3600s
NGINX_PROXY_SEND_TIMEOUT=3600s


############################################
# CHECKS
############################################

# yes / no
VERIFY_HTTP3_IMAGE=yes
